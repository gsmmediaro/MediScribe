# MediScribe Environment Configuration
# Copy this file to .env and fill in your values

# n8n Webhook URL (REQUIRED)
# Get this from your n8n workflow webhook node
# Example: https://your-instance.app.n8n.cloud/webhook/medical-assistant
VITE_N8N_WEBHOOK_URL=

# Development Server Port (Optional)
# Default: 3000
VITE_PORT=3000
