# Google Gemini API Key (for live transcription fallback)
# Get your API key from: https://makersuite.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# n8n Webhook URL (for main backend processing)
# Replace with your n8n workflow webhook URL
# Example: https://your-n8n-instance.com/webhook/mediscribe-consultation
N8N_WEBHOOK_URL=http://localhost:5678/webhook/mediscribe-consultation

# Optional: Deepgram API Key (if using Deepgram directly instead of through n8n)
# Get your API key from: https://console.deepgram.com/
# DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: MongoDB Connection String (if connecting directly instead of through n8n)
# MONGODB_URI=mongodb://localhost:27017/mediscribe
